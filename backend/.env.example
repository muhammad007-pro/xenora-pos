# ── Loyiha ──────────────────────────────────────────────────────────────────
PROJECT_NAME=RestoPOS
VERSION=1.0.0
ENVIRONMENT=development        # development | staging | production
DEBUG=True
TIMEZONE=Asia/Tashkent

# ── Ma'lumotlar bazasi (PostgreSQL) ─────────────────────────────────────────
# Lokal dev uchun: pos_user va restaurant_pos bazasini avval yarating
#   psql -U postgres -c "CREATE USER pos_user WITH PASSWORD 'your_password';"
#   psql -U postgres -c "CREATE DATABASE restaurant_pos OWNER pos_user;"
DATABASE_URL=postgresql://pos_user:your_password@localhost:5432/restaurant_pos

# ── Xavfsizlik ───────────────────────────────────────────────────────────────
# DEPLOY MAJBURIY: SECRET_KEY ni kuchli tasodifiy kalitga o'zgartiring (kamida 32 belgi).
#   python -c "import secrets; print(secrets.token_hex(32))"
# Bu kalit MAXFIY — .env git'ga tushmaydi. Production'da standart/kuchsiz kalit → server ishga tushmaydi.
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Boshlang'ich super-admin (platforma egasi) ───────────────────────────────
# Toza bazada birinchi startup'da AVTOMATIK yaratiladi (alembic upgrade head'dan keyin).
# Telefon — login kaliti. DEPLOY MAJBURIY: parolni kuchli qiymatga o'zgartiring —
# standart/kuchsiz parol (admin4770, admin, password, kamida 8 belgidan qisqa) bilan
# production ishga tushmaydi. Deploy'dan keyin ilova ichidan parolni yana almashtiring.
FIRST_SUPERUSER_PHONE=+998900000000
FIRST_SUPERUSER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
FIRST_SUPERUSER_EMAIL=owner@yourdomain.uz
FIRST_SUPERUSER_NAME=Platform Owner
FIRST_SUPERUSER_USERNAME=admin

# ── CORS ─────────────────────────────────────────────────────────────────────
# DEPLOY: production'da FAQAT o'z domening (localhost'larni olib tashla). "*" ISHLATMA.
#   BACKEND_CORS_ORIGINS=["https://xenora.uz","https://www.xenora.uz"]
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:5500","http://127.0.0.1:5500"]

# ── Rate limiting (brute-force + DDoS himoya) ─────────────────────────────────
RATE_LIMIT_ENABLED=True
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_GENERAL_PER_MIN=600

# ── Fayl yuklash ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE=5242880        # 5 MB (baytda)
UPLOAD_DIR=static/uploads

# ── Printer ──────────────────────────────────────────────────────────────────
PRINTER_ENABLED=False
PRINTER_PORT=COM1
PRINTER_BAUD_RATE=9600

# ── To'lov — Click (https://click.uz) ── (maxfiy — onlayn to'lov yoqilsa to'ldiriladi)
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# ── To'lov — Payme (https://payme.uz) ── (maxfiy — real to'lovda PAYME_TEST_MODE=False)
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_MODE=True

# ── SMS xabarnomasi ───────────────────────────────────────────────────────────
SMS_API_KEY=
SMS_SENDER_ID=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@restopos.uz

# ── Zaxira nusxa ─────────────────────────────────────────────────────────────
BACKUP_ENABLED=True
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=30

# ── AI-Ombor (Claude API — rasmdan mahsulot o'qish) ──────────────────────────
# API kalit FAQAT serverda saqlanadi (bu fayl .gitignore'da — GitHub'ga ketmaydi).
# Haqiqiy kalitni platform.claude.com dan oling va CHANGE_ME o'rniga qo'ying.
# Bo'sh yoki CHANGE_ME bo'lsa — /ai-warehouse/scan 503 (server ishlashda davom etadi).
ANTHROPIC_API_KEY=CHANGE_ME
AI_WAREHOUSE_MODEL=claude-haiku-4-5
AI_WAREHOUSE_ENABLED=True

# ── Xato kuzatuvi (Sentry) ──
# Bo'sh yoki placeholder → Sentry ISHGA TUSHMAYDI (dev shovqinsiz, RAM tejaladi).
# Haqiqiy DSN'ni sentry.io loyihasidan oling; FAQAT serverда .env ga qo'ying (bu fayl namuna).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── Alert (Telegram) — bitta bot, IKKI AYRIM kanal ──
# ALERT_CHAT_ID        — BIZNES: obuna ogohlantirishlari (7/3/1 kun, blok).
# SENTRY_ALERT_CHAT_ID — TEXNIKA: 5xx xatolar. BO'SH = Sentry Telegram xabari
#                        umuman yuborilmaydi (Sentry'ning o'zi ishlayveradi).
# Ikkalasi ataylab ajratilgan: texnik shovqin biznes xabarini ko'mib qo'ymasin.
TELEGRAM_BOT_TOKEN=
ALERT_CHAT_ID=
SENTRY_ALERT_CHAT_ID=
