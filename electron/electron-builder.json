{
  "appId": "com.xenora.app",
  "productName": "XENORA",
  "directories": {
    "output": "dist"
  },
  "files": [
    "main.js",
    "preload.js",
    "loading.html",
    "assets/**/*",
    "!**/*.log",
    "!dist/**"
  ],
  "extraResources": [
    {
      "from": "../frontend",
      "to": "frontend",
      "filter": [
        "**/*",
        "!**/*.map",
        "!**/.gitkeep"
      ]
    }
  ],
  "win": {
    "target": ["nsis", "portable"],
    "icon": "assets/icon.ico",
    "publisherName": "XENORA"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "XENORA"
  },
  "portable": {
    "artifactName": "XENORA-Portable-${version}.exe"
  }
}
