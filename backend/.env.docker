# ── RestoPOS Docker Production ─────────────────────────────────────────────
# Bu faylni .env ga nusxalang va kerakli qiymatlarni o'zgartiring:
#   cp backend/.env.docker backend/.env

PROJECT_NAME=RestoPOS
VERSION=1.0.0
ENVIRONMENT=production
DEBUG=False
TIMEZONE=Asia/Tashkent

# ── Database (docker-compose da 'db' servis islatiladi) ─────────────────────
# docker-compose.yml da bu qiymat avtomatik override qilinadi
DATABASE_URL=postgresql://pos_user:pos_pass123@db:5432/restaurant_pos

# ── MUHIM: Xavfsizlik ────────────────────────────────────────────────────────
# Yangi kalit yaratish:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_PYTHON_SECRETS

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── MUHIM: Boshlang'ich super-admin (platforma egasi) ────────────────────────
# Toza bazada birinchi startup'da avtomatik yaratiladi. Parolni MAJBURIY
# o'zgartiring — standart/kuchsiz parol bilan production ishga tushmaydi.
FIRST_SUPERUSER_PHONE=+998900000000
FIRST_SUPERUSER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
FIRST_SUPERUSER_EMAIL=owner@yourdomain.uz
FIRST_SUPERUSER_NAME=Platform Owner
FIRST_SUPERUSER_USERNAME=admin

# ── CORS (domeningizga moslang) ───────────────────────────────────────────────
# Misol: https://restopos.uz uchun:
BACKEND_CORS_ORIGINS=["http://localhost","https://localhost"]

# ── Fayl yuklash ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE=5242880
UPLOAD_DIR=static/uploads

# ── Printer ──────────────────────────────────────────────────────────────────
PRINTER_ENABLED=False
PRINTER_PORT=COM1
PRINTER_BAUD_RATE=9600

# ── To'lov — Click ───────────────────────────────────────────────────────────
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# ── To'lov — Payme ───────────────────────────────────────────────────────────
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_MODE=False

# ── SMS ───────────────────────────────────────────────────────────────────────
SMS_API_KEY=
SMS_SENDER_ID=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@restopos.uz

# ── Zaxira nusxa ─────────────────────────────────────────────────────────────
BACKUP_ENABLED=True
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=30
